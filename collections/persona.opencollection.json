        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://withpersona.com/api/v1/accounts",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a paginated list of accounts in the organization."
        },
        {
          "info": {
            "name": "Create an Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
