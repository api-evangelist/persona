{
  "opencollection": "1.0.0",
  "info": {
    "name": "Persona Accounts Reports API",
    "version": "2025-12-08"
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://withpersona.com/api/v1/reports",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all Reports"
        },
        {
          "info": {
            "name": "Create a Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://withpersona.com/api/v1/reports",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a Report"
        },
        {
          "info": {
            "name": "Retrieve a Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://withpersona.com/api/v1/reports/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a Report"
        }
      ]
    }
  ],
  "bundled": true
}